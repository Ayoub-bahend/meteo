# Configuration pour Docker Compose
# Copiez ce fichier en .env et ajustez les valeurs

# AWS ECR Registry URI
# Format: <AWS_ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com
ECR_REGISTRY=864522970972.dkr.ecr.us-east-1.amazonaws.com

# Tag de l'image Docker (latest, ou SHA du commit)
IMAGE_TAG=latest

# Alternative: Utiliser des images locales si vous avez buildé localement
# ECR_REGISTRY=meteo
# IMAGE_TAG=latest

